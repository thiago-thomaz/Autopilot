// Prisma Schema for Affiliate Autopilot
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlatformStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  PENDING_VALIDATION
}

enum AffiliateAccountStatus {
  PENDING_CONFIGURATION
  CONFIGURED
  CONNECTED
  CONNECTION_ERROR
  DISABLED
  MANUAL_REQUIRED
  NOT_AVAILABLE
}

enum AffiliateEnvironment {
  DEVELOPMENT
  PRODUCTION
}

enum ProductStatus {
  DISCOVERED
  ANALYZING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ProductSourceType {
  API
  MANUAL
  MOCK
}

enum ProductTagType {
  NICHO
  CATEGORIA
  MARCA
  ESTRATEGIA
  CAMPANHA
  MANUAL
}

enum ProductRejectionReason {
  INVALID_TITLE
  INVALID_ID
  INVALID_URL
  INVALID_PRICE
  INVALID_RATING
  INVALID_CURRENCY
  MISSING_REQUIRED_FIELD
  UNSUPPORTED_PRODUCT
}

enum OpportunityClassification {
  EXCEPTIONAL
  HIGH
  GOOD
  MODERATE
  LOW
  VERY_LOW
}

enum OpportunityPriority {
  P0
  P1
  P2
  P3
  P4
}

enum OpportunityAlertType {
  NEW_EXCEPTIONAL_PRODUCT
  PRICE_DROP
  NEW_HIGH_OPPORTUNITY
  COMMISSION_CHANGE
  STOCK_CHANGE
  SCORE_INCREASE
  SCORE_DECREASE
}

enum BlocklistType {
  PRODUCT
  BRAND
  CATEGORY
  KEYWORD
}

enum ContentPackageType {
  SOCIAL_POST
  SHORT_VIDEO
  LONG_VIDEO
  PRODUCT_REVIEW
  PRODUCT_COMPARISON
  DEAL_ALERT
  TOP_LIST
  TUTORIAL
  PROBLEM_SOLUTION
  PRODUCT_SHOWCASE
  EVERGREEN
  SEASONAL
}

enum ContentAngleType {
  DEAL
  PROBLEM_SOLUTION
  BENEFIT
  COMPARISON
  REVIEW
  TUTORIAL
  TOP_LIST
  DISCOVERY
  EDUCATIONAL
  SEASONAL
  EVERGREEN
}

enum ContentPackageStatus {
  DRAFT
  GENERATING
  GENERATED
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  READY_FOR_PUBLICATION
  ARCHIVED
}

enum OmnichannelPublicationStatus {
  DRAFT
  QUEUED
  SCHEDULED
  VALIDATING
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  RETRYING
  CANCELLED
  EXPIRED
  MANUAL_REQUIRED
  BLOCKED
  REVALIDATION_REQUIRED
}

enum PublicationAccountStatus {
  ACTIVE
  INACTIVE
  AUTH_REQUIRED
  LIMITED
  ALLOWLIST_REQUIRED
  MANUAL_REQUIRED
  BLOCKED
  ERROR
  DISABLED
}

enum OmnichannelChannel {
  INSTAGRAM
  FACEBOOK_PAGES
  TIKTOK
  YOUTUBE
  YOUTUBE_SHORTS
  PINTEREST
  X
  THREADS
  WHATSAPP
  TELEGRAM
  SNAPCHAT
  LINKEDIN_PAGES
  GOOGLE_BUSINESS_PROFILE
  REDDIT
  DISCORD
  BLOG
  EMAIL
  WEB_PUSH
  RSS
  OWN_WEBSITE
}

enum ClickStatus {
  VALID
  INVALID
  DUPLICATE
  BOT
  SUSPICIOUS
  EXPIRED
  BLOCKED
}

enum AffiliateClickStatus {
  REDIRECTED
  LANDED
  FAILED
  EXPIRED
  BLOCKED
  UNKNOWN
}

enum ConversionType {
  SALE
  LEAD
  SIGNUP
  SUBSCRIPTION
  TRIAL
  APP_INSTALL
  RENEWAL
  OTHER
}

enum ConversionRecordStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  REVERSED
  PAID
  UNKNOWN
}

enum CommissionRecordStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
  PAID
  UNKNOWN
}

enum CostType {
  AI
  API
  N8N
  HOSTING
  DATABASE
  STORAGE
  EMAIL
  MESSAGING
  ADS
  DOMAIN
  SOFTWARE
  TRANSACTION
  OTHER
}

enum AttributionModel {
  LAST_CLICK
  FIRST_CLICK
  LINEAR
  POSITION_BASED
  TIME_DECAY
  DATA_DRIVEN_READY
}

enum SignalType {
  INCREASE_PRIORITY
  DECREASE_PRIORITY
  PAUSE
  REVIEW
  RETEST
  RELOCALIZE
  REPUBLISH
  CHANGE_CONTENT
  CHANGE_CHANNEL
  CHANGE_SCHEDULE
  CHANGE_PRODUCT
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  INCONCLUSIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ContentType {
  SOCIAL_POST
  SHORT_VIDEO_SCRIPT
  EMAIL
  BLOG_ARTICLE
  AD_COPY
  MESSAGE
}

enum ContentStatus {
  DRAFT
  PENDING_COMPLIANCE
  APPROVED
  REJECTED
  ARCHIVED
}

enum ChannelType {
  TELEGRAM_CHANNEL
  TELEGRAM_GROUP
  WHATSAPP_GROUP
  INSTAGRAM
  TIKTOK
  BLOG
  EMAIL_LIST
}

enum ChannelPlatform {
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  TIKTOK
  WORDPRESS
  CUSTOM_WEBHOOK
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
  ERROR
  PAUSED
}

enum PublicationStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AutomationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum QueuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum ComplianceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceStatus {
  PENDING
  PASSED
  FAILED
  OVERRIDDEN
}

enum OperationMode {
  MANUAL
  SEMI_AUTOMATICO
  AUTOMATICO
}

// ==========================================
// ENTITIES
// ==========================================

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  status           UserStatus         @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  affiliateAccounts AffiliateAccount[]

  @@index([email])
  @@index([status])
}

model AffiliatePlatform {
  id                            String             @id @default(uuid())
  name                          String
  slug                          String             @unique
  status                        PlatformStatus     @default(ACTIVE)
  apiAvailable                  Boolean            @default(true)
  linkGenerationAvailable       Boolean            @default(true)
  productDiscoveryAvailable     Boolean            @default(true)
  metricsAvailable              Boolean            @default(false)
  commissionReportingAvailable  Boolean            @default(false)
  website                       String?
  documentationUrl              String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  affiliateAccounts             AffiliateAccount[]
  products                      Product[]
  complianceRules               ComplianceRule[]

  @@index([slug])
  @@index([status])
}

model AffiliateAccount {
  id                   String                 @id @default(uuid())
  userId               String
  affiliatePlatformId  String
  accountName          String
  externalAccountId    String?
  status               AffiliateAccountStatus @default(PENDING_CONFIGURATION)
  environment          AffiliateEnvironment   @default(PRODUCTION)
  credentialReference  String?                // Reference ID for CredentialVault
  credentialsEncrypted String                 // Never exposed directly to frontend
  lastConnectionTest   DateTime?
  lastConnectionStatus String?
  lastError            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatePlatform AffiliatePlatform @relation(fields: [affiliatePlatformId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([affiliatePlatformId])
  @@index([status])
  @@index([environment])
}

model Product {
  id                  String            @id @default(uuid())
  externalId          String
  affiliatePlatformId String
  title               String
  description         String?
  url                 String
  imageUrl            String?
  category            String?
  brand               String?
  currentPrice        Float
  previousPrice       Float?
  currency            String            @default("BRL")
  rating              Float?
  reviewCount         Int?              @default(0)
  availability        Boolean           @default(true)
  commissionRate      Float?
  estimatedCommission Float?
  opportunityScore    Float?            @default(0.0)
  status              ProductStatus     @default(DISCOVERED)

  sourceType          ProductSourceType @default(API)
  sourceUrl           String?
  sourceMetadata      Json?
  collectedAt         DateTime          @default(now())
  lastSyncedAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  affiliatePlatform   AffiliatePlatform     @relation(fields: [affiliatePlatformId], references: [id], onDelete: Cascade)
  contents            Content[]
  clickEvents         ClickEvent[]
  conversions         Conversion[]
  complianceChecks    ComplianceCheck[]
  priceHistory        ProductPriceHistory[]
  opportunitySnapshots OpportunitySnapshot[]
  opportunityAlerts    OpportunityAlert[]
  contentPackages     ContentPackage[]

  @@unique([affiliatePlatformId, externalId])
  @@index([externalId])
  @@index([affiliatePlatformId])
  @@index([status])
  @@index([opportunityScore])
  @@index([category])
  @@index([currentPrice])
  @@index([lastSyncedAt])
}

model ProductPriceHistory {
  id              String   @id @default(uuid())
  productId       String
  price           Float
  previousPrice   Float?
  currency        String   @default("BRL")
  discountPercent Float?   @default(0.0)
  availability    Boolean  @default(true)
  source          String?  @default("API")
  capturedAt      DateTime @default(now())

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

model OpportunitySnapshot {
  id                  String                    @id @default(uuid())
  productId           String
  score               Float
  adjustedScore       Float
  confidenceScore     Float
  classification      OpportunityClassification
  priority            OpportunityPriority
  priceScore          Float                     @default(0)
  priceHistoryScore   Float                     @default(0)
  discountScore       Float                     @default(0)
  ratingScore         Float                     @default(0)
  reviewScore         Float                     @default(0)
  commissionScore     Float                     @default(0)
  demandScore         Float                     @default(0)
  availabilityScore   Float                     @default(0)
  contentScore        Float                     @default(0)
  dataQualityScore    Float                     @default(0)
  bonuses             Json?
  penalties           Json?
  explanation         Json?
  algorithmVersion    String                    @default("v1.0.0")
  createdAt           DateTime                  @default(now())

  product             Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([score, confidenceScore])
  @@index([classification])
  @@index([priority])
}

model OpportunityBatchJob {
  id                String              @id @default(uuid())
  status            AutomationJobStatus @default(RUNNING)
  totalProducts     Int                 @default(0)
  processedProducts Int                 @default(0)
  failedProducts    Int                 @default(0)
  startedAt         DateTime            @default(now())
  finishedAt        DateTime?
  algorithmVersion  String              @default("v1.0.0")
  errorMessage      String?

  @@index([status])
  @@index([startedAt])
}

model OpportunityAlert {
  id         String               @id @default(uuid())
  productId  String
  type       OpportunityAlertType
  scoreDelta Float?
  status     String               @default("UNREAD")
  createdAt  DateTime             @default(now())

  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([productId, createdAt])
}

model OpportunityEngineConfig {
  id               String   @id @default(uuid())
  name             String   @default("DefaultConfig")
  algorithmVersion String   @default("v1.0.0")
  weights          Json
  bonuses          Json?
  penalties        Json?
  thresholds       Json?
  freshnessConfig  Json?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductBlocklist {
  id        String        @id @default(uuid())
  type      BlocklistType
  value     String
  reason    String?
  createdAt DateTime      @default(now())

  @@index([type, value])
}

model ProductAllowlist {
  id          String        @id @default(uuid())
  type        BlocklistType
  value       String
  boostFactor Float         @default(1.1)
  createdAt   DateTime      @default(now())

  @@index([type, value])
}

model ContentPackage {
  id                    String               @id @default(uuid())
  productId             String
  opportunitySnapshotId String?
  platform              String               @default("amazon-brasil")
  contentType           ContentPackageType   @default(SOCIAL_POST)
  channel               ChannelPlatform      @default(INSTAGRAM)
  language              String               @default("pt-BR")
  country               String               @default("BR")
  angle                 ContentAngleType     @default(DEAL)
  targetAudience        String?
  hook                  String
  title                 String
  subtitle              String?
  shortDescription      String?
  longDescription       String?
  bullets               Json?
  caption               String
  cta                   String
  hashtags              Json?
  keywords              Json?
  script                Json?
  visualBrief           Json?
  videoBrief            Json?
  affiliateDisclosure   String?
  sourceData            Json?
  generationMetadata    Json?
  qualityScore          Float                @default(0)
  complianceScore       Float                @default(0)
  status                ContentPackageStatus @default(DRAFT)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  product               Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions              ContentVersion[]
  queues                ContentQueue[]
  publicationRecords    PublicationRecord[]

  @@index([productId])
  @@index([status])
  @@index([channel])
  @@index([contentType])
  @@index([qualityScore])
  @@index([complianceScore])
}

model ContentVersion {
  id               String         @id @default(uuid())
  contentPackageId String
  version          Int            @default(1)
  content          Json
  generationMethod String         @default("LLM")
  model            String         @default("gpt-4o-mini")
  promptVersion    String         @default("v1.0.0")
  qualityScore     Float          @default(0)
  complianceScore  Float          @default(0)
  createdAt        DateTime       @default(now())

  contentPackage   ContentPackage @relation(fields: [contentPackageId], references: [id], onDelete: Cascade)

  @@index([contentPackageId])
}

model ContentQueue {
  id               String          @id @default(uuid())
  contentPackageId String
  priority         QueuePriority   @default(NORMAL)
  status           String          @default("PENDING")
  scheduledAt      DateTime        @default(now())
  channel          ChannelPlatform @default(INSTAGRAM)
  createdAt        DateTime        @default(now())

  contentPackage   ContentPackage  @relation(fields: [contentPackageId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PublicationRecord {
  id                    String                       @id @default(uuid())
  contentPackageId      String
  contentVersionId      String?
  productId             String
  opportunityId         String?
  channel               OmnichannelChannel           @default(INSTAGRAM)
  platform              String                       @default("instagram")
  accountId             String?
  publicationType       String                       @default("AUTOMATIC")
  status                OmnichannelPublicationStatus @default(DRAFT)
  publicationPayload    Json?
  trackingUrl           String?
  externalPublicationId String?
  externalUrl           String?
  scheduledAt           DateTime                     @default(now())
  startedAt             DateTime?
  publishedAt           DateTime?
  failedAt              DateTime?
  retryCount            Int                          @default(0)
  maxRetries            Int                          @default(3)
  idempotencyKey        String                       @unique
  country               String                       @default("BR")
  language              String                       @default("pt-BR")
  currency              String                       @default("BRL")
  timezone              String                       @default("America/Sao_Paulo")
  campaignId            String?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  contentPackage        ContentPackage               @relation(fields: [contentPackageId], references: [id], onDelete: Cascade)
  auditLogs             PublicationAuditLog[]
  queueItems            PublicationQueueItem[]

  @@index([contentPackageId])
  @@index([status])
  @@index([channel])
  @@index([country])
  @@index([scheduledAt])
}

model PublicationAccount {
  id                   String                   @id @default(uuid())
  platform             String
  accountName          String
  accountIdentifier    String
  country              String                   @default("BR")
  language             String                   @default("pt-BR")
  timezone             String                   @default("America/Sao_Paulo")
  currency             String                   @default("BRL")
  status               PublicationAccountStatus @default(ACTIVE)
  credentialReference  String?
  capabilities         Json?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([platform, status])
  @@index([accountIdentifier])
}

model PublicationProfile {
  id                   String             @id @default(uuid())
  name                 String
  channel              OmnichannelChannel
  accountId            String?
  country              String             @default("BR")
  language             String             @default("pt-BR")
  currency             String             @default("BRL")
  timezone             String             @default("America/Sao_Paulo")
  enabled              Boolean            @default(true)
  autoPublishEnabled   Boolean            @default(true)
  requiresApproval     Boolean            @default(false)
  maxDailyPublications Int                @default(10)
  maxHourlyPublications Int               @default(2)
  minIntervalMinutes   Int                @default(30)
  allowedContentTypes  Json?
  allowedCategories    Json?
  blockedCategories    Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([channel])
  @@index([country])
}

model PublicationRule {
  id                  String             @id @default(uuid())
  channel             OmnichannelChannel
  country             String             @default("BR")
  language            String             @default("pt-BR")
  contentType         String             @default("ALL")
  enabled             Boolean            @default(true)
  minQualityScore     Float              @default(70.0)
  minComplianceScore  Float              @default(90.0)
  maxDaily            Int                @default(10)
  maxHourly           Int                @default(2)
  minInterval         Int                @default(30)
  allowedHours        Json?
  blockedHours        Json?
  requiresApproval    Boolean            @default(false)
  requiresTracking    Boolean            @default(true)
  requiresDisclosure  Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([channel, country])
}

model PublicationQueueItem {
  id            String            @id @default(uuid())
  publicationId String
  priority      QueuePriority     @default(NORMAL)
  scheduledAt   DateTime          @default(now())
  status        String            @default("PENDING")
  attempts      Int               @default(0)
  lockedAt      DateTime?
  workerId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  publication   PublicationRecord @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([publicationId])
}

model PublicationAuditLog {
  id            String            @id @default(uuid())
  publicationId String
  event         String
  details       Json?
  createdAt     DateTime          @default(now())

  publication   PublicationRecord @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

model WhatsAppOptIn {
  id          String   @id @default(uuid())
  phone       String   @unique
  status      String   @default("OPTED_IN")
  optInSource String?
  optOutReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model WhatsAppSuppressionList {
  id        String   @id @default(uuid())
  phone     String   @unique
  reason    String   @default("USER_OPT_OUT")
  createdAt DateTime @default(now())
}

model EmailContact {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  country      String    @default("BR")
  language     String    @default("pt-BR")
  consentGiven Boolean   @default(true)
  optedOutAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([consentGiven])
}

model WhatsAppContact {
  id           String    @id @default(uuid())
  phone        String    @unique
  name         String?
  country      String    @default("BR")
  language     String    @default("pt-BR")
  consentGiven Boolean   @default(true)
  optedOutAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([consentGiven])
}

model PublicationBlocklist {
  id        String   @id @default(uuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@index([type, value])
}

model PublicationAllowlist {
  id        String   @id @default(uuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@index([type, value])
}

model GlobalCampaign {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  status          CampaignStatus @default(DRAFT)
  targetCountries Json?
  targetLanguages Json?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MarketProfile {
  id              String   @id @default(uuid())
  countryCode     String   @unique
  countryName     String
  defaultLanguage String
  defaultCurrency String
  defaultTimezone String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// MODULE 7: ANALYTICS & ATTRIBUTION MODELS
// ==========================================

model AnalyticsEvent {
  id                 String   @id @default(uuid())
  eventType          String
  eventSource        String
  eventSourceId      String?
  timestamp          DateTime @default(now())
  userReference      String?
  sessionId          String?
  anonymousId        String?
  country            String   @default("BR")
  language           String   @default("pt-BR")
  currency           String   @default("BRL")
  timezone           String   @default("America/Sao_Paulo")
  channel            String?
  platform           String?
  accountId          String?
  campaignId         String?
  contentPackageId   String?
  contentVersionId   String?
  publicationId      String?
  productId          String?
  opportunityId      String?
  affiliateProgramId String?
  affiliateLinkId    String?
  trackingId         String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([timestamp, eventType])
  @@index([trackingId])
}

model AnalyticsSession {
  id              String    @id @default(uuid())
  anonymousId     String
  userReference   String?
  startedAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  endedAt         DateTime?
  country         String    @default("BR")
  language        String    @default("pt-BR")
  timezone        String    @default("America/Sao_Paulo")
  device          String?
  browser         String?
  os              String?
  firstSource     String?
  firstMedium     String?
  firstCampaign   String?
  landingPage     String?
  lastSource      String?
  lastMedium      String?
  lastCampaign    String?
  converted       Boolean   @default(false)
  conversionValue Decimal?  @db.Decimal(18, 4)
  currency        String    @default("BRL")
}

model AnalyticsClick {
  id               String      @id @default(uuid())
  trackingId       String
  timestamp        DateTime    @default(now())
  channel          String?
  platform         String?
  publicationId    String?
  contentVersionId String?
  campaignId       String?
  productId        String?
  affiliateLinkId  String?
  country          String      @default("BR")
  language         String      @default("pt-BR")
  device           String?
  sessionId        String?
  destination      String
  status           ClickStatus @default(VALID)
  qualityScore     Float       @default(100.0)

  @@index([trackingId, status])
}

model AffiliateClickRecord {
  id                 String               @id @default(uuid())
  trackingId         String
  affiliateLinkId    String?
  affiliateProgramId String?
  networkId          String?
  productId          String?
  publicationId      String?
  channel            String?
  campaignId         String?
