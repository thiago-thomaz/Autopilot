// ==========================================
// MÓDULO 8 — AUTONOMOUS OPTIMIZATION & DECISION ENGINE ENUMS
// ==========================================

enum AutonomyLevel {
  LEVEL_0_OBSERVE
  LEVEL_1_RECOMMEND
  LEVEL_2_AUTO_LOW_RISK
  LEVEL_3_AUTO_MEDIUM_RISK
  LEVEL_4_SUPERVISED_HIGH_IMPACT
  LEVEL_5_FULL_AUTONOMY_ALLOWED_ACTIONS
}

enum DecisionType {
  INCREASE_PRIORITY
  DECREASE_PRIORITY
  PAUSE
  RESUME
  RETEST
  RECREATE_CONTENT
  REFRESH_CONTENT
  CHANGE_CONTENT_VARIANT
  CHANGE_CHANNEL
  CHANGE_COUNTRY
  CHANGE_LANGUAGE
  CHANGE_SCHEDULE
  INCREASE_DISTRIBUTION
  DECREASE_DISTRIBUTION
  CHANGE_PRODUCT
  CHANGE_OFFER
  STOP_UNPROFITABLE
  SCALE_WINNER
  START_EXPERIMENT
  END_EXPERIMENT
  REQUEST_REVIEW
}

enum PolicyResult {
  ALLOW
  DENY
  REVIEW_REQUIRED
  UNKNOWN
}

enum DecisionStatus {
  PENDING
  ANALYZING
  APPROVED
  REJECTED
  SCHEDULED
  EXECUTING
  EXECUTED
  FAILED
  ROLLED_BACK
  EXPIRED
  CANCELLED
}

enum ActionType {
  UPDATE_PRIORITY
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  CREATE_CONTENT_TASK
  CHANGE_CONTENT_VARIANT
  CREATE_PUBLICATION_TASK
  UPDATE_SCHEDULE
  CHANGE_CHANNEL_PRIORITY
  CHANGE_COUNTRY_PRIORITY
  CHANGE_LANGUAGE_PRIORITY
  CREATE_EXPERIMENT
  END_EXPERIMENT
  REFRESH_PRODUCT_DATA
  REFRESH_OFFER
  DISABLE_PRODUCT
  ENABLE_PRODUCT
  SEND_REPORT
  SEND_ALERT
}

enum ActionStatus {
  PENDING
  SCHEDULED
  EXECUTING
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SNOOZED
}

// ==========================================
// MÓDULO 8 — AUTONOMOUS OPTIMIZATION & DECISION ENGINE MODELS
// ==========================================

model Decision {
  id               String         @id @default(uuid())
  timestamp        DateTime       @default(now())
  scope            String         @default("GLOBAL") // GLOBAL, PRODUCT, CHANNEL, CAMPAIGN, COUNTRY
  entityType       String         // Product, Campaign, Content, Channel, etc.
  entityId         String
  decisionType     DecisionType
  reason           String
  confidence       Float          @default(0.0) // 0.0 to 1.0
  expectedImpact   Json?          // { profitDelta: number, roiDelta: number }
  riskScore        Float          @default(0.0) // 0 to 100
  priority         Int            @default(3) // 0 to 5
  autonomyLevel    AutonomyLevel  @default(LEVEL_1_RECOMMEND)
  policyResult     PolicyResult   @default(UNKNOWN)
  approvalRequired Boolean        @default(true)
  status           DecisionStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  executedAt       DateTime?

  actions          Action[]
  actionPlans      ActionPlan[]
  outcomes         DecisionOutcome[]
  riskAssessments  RiskAssessment[]
  approvalRequests ApprovalRequest[]
  histories        DecisionHistory[]

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model Action {
  id                String       @id @default(uuid())
  decisionId        String
  actionType        ActionType
  platform          String       @default("INTERNAL") // WEBSITE, BLOG, EMAIL, INSTAGRAM, etc.
  accountId         String?
  entityType        String
  entityId          String
  payload           Json?
  scheduledAt       DateTime?
  executedAt        DateTime?
  status            ActionStatus @default(PENDING)
  result            Json?
  error             String?
  rollbackAvailable Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  decision          Decision          @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  approvalRequests  ApprovalRequest[]

  @@index([status, scheduledAt])
  @@index([decisionId])
}

model ActionPlan {
  id                String       @id @default(uuid())
  decisionId        String
  steps             Json         // Array of step definitions
  estimatedCost     Float        @default(0.0)
  estimatedDuration Int          @default(0) // seconds
  risk              RiskLevel    @default(LOW)
  rollbackPlan      Json?        // Steps to revert
  approvalRequired  Boolean      @default(true)
  status            ActionStatus @default(PENDING)
  createdAt         DateTime     @default(now())

  decision          Decision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model DecisionOutcome {
  id               String   @id @default(uuid())
  decisionId       String
  beforeMetrics    Json
  afterMetrics     Json
  delta            Json
  profitImpact     Float    @default(0.0)
  revenueImpact    Float    @default(0.0)
  commissionImpact Float    @default(0.0)
  roiImpact        Float    @default(0.0)
  success          Boolean  @default(true)
  confidence       Float    @default(0.0)
  createdAt        DateTime @default(now())

  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model DecisionRule {
  id          String                @id @default(uuid())
  ruleCode    String                @unique
  name        String
  description String
  scope       String                @default("GLOBAL")
  active      Boolean               @default(true)
  priority    Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  versions    DecisionRuleVersion[]

  @@index([ruleCode])
  @@index([active])
}

model DecisionRuleVersion {
  id         String       @id @default(uuid())
  ruleId     String
  version    Int          @default(1)
  conditions Json         // Condition tree definition
  action     Json         // Decision action specification
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  rule       DecisionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model Policy {
  id          String          @id @default(uuid())
  policyCode  String          @unique
  name        String
  platform    String?         // Specific platform or NULL for global
  country     String?         // Specific country or NULL for global
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PolicyVersion[]

  @@index([policyCode])
  @@index([platform])
}

model PolicyVersion {
  id         String   @id @default(uuid())
  policyId   String
  version    Int      @default(1)
  rules      Json     // Array of compliance constraints
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model RiskAssessment {
  id         String    @id @default(uuid())
  decisionId String
  riskScore  Float     // 0 to 100
  riskLevel  RiskLevel
