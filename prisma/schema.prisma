// ==========================================
// MODULE 14 — CONTINUOUS LEARNING ENUMS
// ==========================================

enum KnowledgeType {
  PATTERN
  RULE
  STRATEGY
  INSIGHT
  RISK
  PLAYBOOK
}

enum KnowledgeStatus {
  NEW
  VALIDATED
  PROCESSED
  REJECTED
  ARCHIVED
}

enum LearningQueuePriority {
  P0
  P1
  P2
  P3
  P4
  HIGH
  MEDIUM
  LOW
  BACKGROUND
}

enum CalibrationTargetModule {
  M9
  M13
}

// ==========================================
// MODULE 14 — CONTINUOUS LEARNING MODELS
// ==========================================

model LearningEvent {
  id              String                @id @default(uuid())
  timestamp       DateTime              @default(now())
  source          String
  entityType      String
  entityId        String
  decisionId      String?
  campaignId      String?
  experimentId    String?
  market          String?
  country         String?
  language        String?
  channel         String?
  metrics         Json
  context         Json
  confidenceScore Decimal               @default(0.5000) @db.Decimal(18, 4)
  qualityScore    Decimal               @default(0.5000) @db.Decimal(18, 4)
  status          KnowledgeStatus       @default(NEW)
  createdAt       DateTime              @default(now())

  @@index([source])
  @@index([entityType, entityId])
  @@index([decisionId])
  @@index([campaignId])
  @@index([status])
  @@index([timestamp])
}

model DiscoveredKnowledge {
  id                 String               @id @default(uuid())
  knowledgeType      KnowledgeType
  title              String
  description        String
  confidence         Decimal              @default(50.0000) @db.Decimal(18, 4)
  importance         Decimal              @default(50.0000) @db.Decimal(18, 4)
  decayFactor        Decimal              @default(0.0100) @db.Decimal(18, 4)
  evidence           Json
  sampleSize         Int                  @default(1)
  market             String?
  country            String?
  language           String?
  channel            String?
  version            Int                  @default(1)
  status             KnowledgeStatus      @default(NEW)
  validFrom          DateTime             @default(now())
  validUntil         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  versions           KnowledgeVersion[]

  @@index([knowledgeType])
  @@index([status])
  @@index([country, language])
  @@index([createdAt])
}

model KnowledgeVersion {
  id                 String              @id @default(uuid())
  knowledgeId        String
  knowledge          DiscoveredKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  version            Int
  delta              Json
  previousConfidence Decimal             @db.Decimal(18, 4)
  newConfidence      Decimal             @db.Decimal(18, 4)
  reason             String
  createdAt          DateTime            @default(now())

  @@index([knowledgeId])
  @@index([version])
}

model ModelCalibrationRecord {
  id                 String                  @id @default(uuid())
  modelId            String
  targetModule       CalibrationTargetModule
  previousMetric     Decimal                 @db.Decimal(18, 4)
  calibratedMetric   Decimal                 @db.Decimal(18, 4)
  adjustmentFactor   Decimal                 @db.Decimal(18, 4)
  reason             String?
  appliedAt          DateTime                @default(now())

  @@index([modelId])
  @@index([targetModule])
  @@index([appliedAt])
}







