{
  "name": "M14 — Daily Knowledge Digest & Calibration Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Daily Cron Trigger (00:00 UTC)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000' }}/api/v1/learning/calibrate",
        "options": {}
      },
      "name": "Execute M14 Learning Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Daily Cron Trigger (00:00 UTC)": {
      "main": [
        [
          {
            "node": "Execute M14 Learning Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
