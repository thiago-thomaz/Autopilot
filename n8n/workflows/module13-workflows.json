{
  "name": "MÓDULO 13 — Autonomous Intelligence & Decision Layer Workflows",
  "workflows": [
    {
      "name": "M13-01 — Event Intake",
      "nodes": [
        { "name": "Webhook Inbound Event", "type": "n8n-nodes-base.webhook", "parameters": { "path": "intelligence/event", "responseMode": "onReceived" } },
        { "name": "HTTP Post Ingestion", "type": "n8n-nodes-base.httpRequest", "parameters": { "url": "http://localhost:3000/api/v1/intelligence/event", "method": "POST" } }
      ]
    },
    {
      "name": "M13-02 — Intelligence Processing",
      "nodes": [
        { "name": "Cron Every 15 Min", "type": "n8n-nodes-base.cron", "parameters": { "triggerTimes": { "item": [{ "minute": 15 }] } } },
        { "name": "HTTP Post Decision Cycle", "type": "n8n-nodes-base.httpRequest", "parameters": { "url": "http://localhost:3000/api/v1/intelligence/decision", "method": "POST" } }
      ]
    },
    {
      "name": "M13-03 — Opportunity Detection",
      "nodes": [
        { "name": "Cron Every Hour", "type": "n8n-nodes-base.cron", "parameters": { "triggerTimes": { "item": [{ "minute": 0 }] } } },
        { "name": "HTTP Get Opportunities", "type": "n8n-nodes-base.httpRequest", "parameters": { "url": "http://localhost:3000/api/v1/intelligence/opportunities", "method": "GET" } }
      ]
    },
    {
