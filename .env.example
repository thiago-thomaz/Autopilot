# APP
NODE_ENV=development
PORT=3000
APP_NAME="Affiliate Autopilot"
DEFAULT_CURRENCY=BRL
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LOCALE=pt-BR
APP_URL="https://cop.projetosunion.cloud"
NEXT_PUBLIC_APP_URL="https://cop.projetosunion.cloud"

# SECURITY & AUTH
JWT_SECRET=super-secret-key-change-in-production
N8N_API_KEY=n8n_secret_autopilot_key_2026
VAULT_SECRET=vault_master_key_change_in_production_32b!

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affiliate_autopilot?schema=public"

# SYSTEM AUTOMATION FLAGS
ENABLE_AUTOMATION=false
OPERATION_MODE=MANUAL

# MOCK MODE FOR AFFILIATE PLATFORMS
AFFILIATE_MOCK_MODE=true

# AMAZON BRASIL CREATORS API (OPCIONAL QUANDO MOCK=true)
AMAZON_CREDENTIAL_ID=amzn_cred_id_placeholder
AMAZON_CREDENTIAL_SECRET=amzn_cred_secret_placeholder
AMAZON_CREDENTIAL_VERSION=v1
AMAZON_PARTNER_TAG=meutagafiliado-20
AMAZON_MARKETPLACE=amazon.com.br
AMAZON_REGION=us-east-1
