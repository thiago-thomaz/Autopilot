# ==========================================
# AFFILIATE AUTOPILOT - ENVIRONMENT TEMPLATE
# ==========================================

# APP CONFIGURATION
NODE_ENV=development
PORT=3000
APP_NAME="Affiliate Autopilot"
DEFAULT_CURRENCY=BRL
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LOCALE=pt-BR
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SECURITY & AUTH
JWT_SECRET=your_super_secret_jwt_key_here
INTERNAL_AUTOMATION_KEY=your_internal_automation_key_here
VAULT_SECRET=your_vault_master_key_here

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affiliate_autopilot?schema=public"

# SYSTEM AUTOMATION FLAGS (100% NATIVO - ZERO N8N)
ENABLE_AUTOMATION=true
OPERATION_MODE=AUTOMATICO
AUTONOMOUS_MODE=SUPERVISED
AUTONOMOUS_PUBLISHING_INTERVAL_MS=120000
AUTONOMOUS_REMINDERS_INTERVAL_MS=300000
AUTONOMOUS_DECISION_INTERVAL_MS=3600000
AUTONOMOUS_DISCOVERY_INTERVAL_MS=10800000

# MOCK MODE FOR AFFILIATE PLATFORMS & LLM
AFFILIATE_MOCK_MODE=true
MOCK_LLM=true

# AMAZON BRASIL CREATORS / PARTNER API
NEXT_PUBLIC_AMAZON_PARTNER_TAG=suatag-20
AMAZON_PARTNER_TAG=suatag-20
AMAZON_CREDENTIAL_ID=your_amazon_credential_id
AMAZON_CREDENTIAL_SECRET=your_amazon_credential_secret
AMAZON_CREDENTIAL_VERSION=v1
AMAZON_MARKETPLACE=amazon.com.br
AMAZON_REGION=us-east-1

# MERCADO LIVRE
MERCADO_LIVRE_AFFILIATE_TAG=your_mercadolivre_tag_here

# TELEGRAM BOT & NOTIFICATIONS
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
